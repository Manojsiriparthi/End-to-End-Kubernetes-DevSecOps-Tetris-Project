// Jenkins-Infra.grrovy
// Declarative Jenkins pipeline to manage Terraform infra in 'infra' folder
// - Parameters: ENV (dev/test/prod), ACTION (plan/apply/destroy), AWS_CREDENTIALS_ID (optional), TF_DIR (default infra)
// - For apply/destroy on test and prod the pipeline requires manual approval
// - If AWS_CREDENTIALS_ID is not provided the node's IAM role (instance profile) will be used

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
  }

  parameters {
    choice(name: 'ENV', choices: ['dev','test','prod'], description: 'Target environment (affects TF workspace/state)')
    choice(name: 'ACTION', choices: ['plan','apply','destroy'], description: 'Terraform action to perform')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: '', description: '(optional) Jenkins AWS credentials ID. Leave empty to use instance/IAM role on Jenkins server')
    string(name: 'TF_DIR', defaultValue: 'infra', description: 'Path to Terraform configuration (relative to repo root)')
    string(name: 'TF_WORKSPACE', defaultValue: '', description: '(optional) Terraform workspace name — if empty the pipeline will use ENV')
    booleanParam(name: 'AUTO_APPROVE_DEV', defaultValue: true, description: 'Allow auto-approve for dev apply/destroy without manual confirmation')
    string(name: 'GIT_REPO_URL', defaultValue: 'https://github.com/Manojsiriparthi/End-to-End-Kubernetes-DevSecOps-Tetris-Project.git', description: 'Git repository URL')
    string(name: 'GIT_BRANCH', defaultValue: 'master', description: 'Git branch to checkout')
  }

  environment {
    // Default workspace fallback
    TF_WS = "${params.TF_WORKSPACE ?: params.ENV}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: "${params.GIT_BRANCH}"]],
          userRemoteConfigs: [[url: "${params.GIT_REPO_URL}"]]
        ])
      }
    }

    stage('Sanity: check infra folder') {
      steps {
        script {
          def dirExists = fileExists(params.TF_DIR)
          if (!dirExists) {
            error "Terraform directory '${params.TF_DIR}' not found in repo. Aborting."
          } else {
            echo "Found Terraform dir: ${params.TF_DIR}"
          }
        }
      }
    }

    stage('Prepare Terraform') {
      steps {
        dir(params.TF_DIR) {
          script {
            sh 'terraform --version'
          }
        }
      }
    }

    stage('Terraform Init') {
      steps {
        dir(params.TF_DIR) {
          script {
            sh "terraform init -input=false -no-color"

            // create/select workspace (use env-based workspace default)
            if (env.TF_WS) {
              sh "terraform workspace list || true"
              // try select, if fails create
              def sel = sh(script: "terraform workspace select ${env.TF_WS} || true", returnStatus: true)
              if (sel != 0) {
                echo "Workspace ${env.TF_WS} not found, creating it"
                sh "terraform workspace new ${env.TF_WS}"
              } else {
                echo "Using workspace ${env.TF_WS}"
              }
            }
          }
        }
      }
    }

    stage('Terraform Plan') {
      when {
        expression { params.ACTION == 'plan' || params.ACTION == 'apply' || params.ACTION == 'destroy' }
      }
      steps {
        script {
          dir(params.TF_DIR) {
            if (params.ACTION == 'destroy') {
              // plan destroy
              sh "terraform plan -destroy -input=false -no-color -out=tfplan"
            } else {
              sh "terraform plan -input=false -no-color -out=tfplan"
            }

            // show a short human-friendly plan
            sh "terraform show -no-color tfplan | sed -n '1,200p' || true"
          }
        }
      }
    }

    stage('Approval') {
      when {
        expression {
          // require approval for apply/destroy on test/prod; dev may be auto-approved based on AUTO_APPROVE_DEV
          (params.ACTION == 'apply' || params.ACTION == 'destroy') && (params.ENV == 'test' || params.ENV == 'prod' || (params.ENV == 'dev' && !params.AUTO_APPROVE_DEV))
        }
      }
      steps {
        script {
          // Prompt for manual approval
          timeout(time: 2, unit: 'HOURS') {
            input message: "Approve ${params.ACTION} on ${params.ENV}?", ok: "Proceed", submitter: '', parameters: [string(name: 'APPROVER_NOTE', defaultValue: '', description: 'Optional note')]
          }
        }
      }
    }

    stage('Terraform Apply/Destroy') {
      when {
        expression { params.ACTION == 'apply' || params.ACTION == 'destroy' }
      }
      steps {
        script {
          dir(params.TF_DIR) {
            // If user provided AWS credentials id, bind them; otherwise rely on instance profile
            if (params.AWS_CREDENTIALS_ID?.trim()) {
              echo "Using Jenkins AWS credentials id: ${params.AWS_CREDENTIALS_ID}"
              withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
                if (params.ACTION == 'destroy') {
                  sh "terraform apply -input=false -no-color -auto-approve tfplan"
                } else {
                  sh "terraform apply -input=false -no-color -auto-approve tfplan"
                }
              }
            } else {
              echo "No AWS_CREDENTIALS_ID provided — using node's IAM role / environment for AWS auth"
              if (params.ACTION == 'destroy') {
                sh "terraform apply -input=false -no-color -auto-approve tfplan"
              } else {
                sh "terraform apply -input=false -no-color -auto-approve tfplan"
              }
            }
          }
        }
      }
    }

    stage('Post: save plan') {
      when {
        expression { params.ACTION == 'plan' }
      }
      steps {
        dir(params.TF_DIR) {
          archiveArtifacts artifacts: 'tfplan', onlyIfSuccessful: true, allowEmptyArchive: false
        }
      }
    }

  }

  post {
    success {
      echo "Pipeline completed successfully for ${params.ENV}/${params.ACTION}"
    }
    failure {
      echo "Pipeline failed"
    }
    always {
      script {
        dir(params.TF_DIR) {
          sh 'terraform workspace show || true'
        }
      }
    }
  }
}
